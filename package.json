{
  "name": "campus-assistant-prototype",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4200 --strictPort",
    "build": "tsc -b && vite build && node scripts/build-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4200 --strictPort",
    "share": "node scripts/serve.mjs",
    "lint": "eslint .",
    "format": "prettier --write src",
    "check": "npm run lint && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  }
}
